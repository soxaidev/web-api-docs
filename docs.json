  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "guides/quickstart",
          "guides/sandbox",
          "guides/sandbox-api-key",
          "guides/authentication",
          "guides/rate-limits",
          "guides/data-fields",
          "guides/troubleshooting"
        ]
      },
      {
        "group": "API Reference (Sandbox)",
        "openapi": {
          "source": "openapi-sandbox.json",
          "directory": "sandbox-api-reference"
        }
      },
      {
        "group": "API Reference (Production)",
        "openapi": {
          "source": "openapi-public.json",
          "directory": "api-reference"
        }
      },
      {
        "group": "About",
        "pages": ["glossary", "changelog", "support"]
      }
    ]
